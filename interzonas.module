<?php

/**
 * @file
 * Interzoans module.
 */

/**
 * Implements hook_theme().
 * Defines the 'mapa' theme hook to use the Twig template.
 */
function interzonas_theme() {
  return [
    'mapa' => [
      'variables' => ['datos_mapa' => NULL],
      'template' => 'mapa', // Refers to mapa.html.twig
    ],
    'mapa_formatter_display' => [
      'variables' => [
        'map_id' => NULL,
        'map_value' => NULL,
        'default_image_url' => NULL,
      ],
      'template' => 'mapa-formatter-display', // Refers to templates/mapa-formatter-display.html.twig
    ],
  ];
}

