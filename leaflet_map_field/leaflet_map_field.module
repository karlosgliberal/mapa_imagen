<?php

/**
 * @file 
 * Main module file for the Leaflet Map Field module.
 */

/**
 * Implements hook_theme().
 */
function leaflet_map_field_theme($existing, $type, $theme, $path) {
  return [
    'leaflet_map_field_formatter_map' => [
      'variables' => [
        'map_id' => NULL,
        'map_width' => '100%',
        'map_height' => '400px',
        // Any other variables needed by the Twig template for the formatter.
      ],
      'template' => 'leaflet-map-field-formatter-map', // Will look for templates/leaflet-map-field-formatter-map.html.twig
    ],
  ];
}

// Removed module_load_include calls. PSR-4 autoloading handles class loading.
// Removed hook_page_alter(). CSS/JS are managed via libraries and dependencies.
// Functionality from .inc files (field, theme, general) has been moved into
// respective D10 plugins (FieldType, FieldWidget, FieldFormatter), Twig templates,
// or this .module file.